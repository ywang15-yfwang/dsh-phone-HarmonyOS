{
  app: {
    signingConfigs: [
      {
        name: 'default',
        type: 'HarmonyOS',
        material: {
          certpath: './signature/phone.cer',
          keyAlias: 'debugKey',
          keyPassword: '0000001A2222D79DC05EE6725A786FB3745BF1CF171DD0E5B5B02C85C353EAE2F88C067906EF4EB15A44',
          profile: './signature/phone.p7b',
          signAlg: 'SHA256withECDSA',
          storeFile: './signature/phone.p12',
          storePassword: '0000001A520D2F74590F278F3BA652788E01CD62E518A56223A13F816938A95B92F5BE23A1EBE366DBC3'
        }
      }
    ],
    // 签名材料说明：
    //   * 证书 / 私钥 / profile（signature/*.cer|*.p12|*.p7b）**不在仓库里**（.gitignore 排除整个 signature/）；
    //   * 下面 signingConfigs 里的 keyAlias 与 keyPassword / storePassword 是 **DevEco 加密后的密文**，
    //     不是明文口令；解密所需的 material/ 也在本机、同样被 gitignore 排除。
    //   * 也就是说：**只 clone 仓库跑不起来签名**，需要自己用 DevEco 生成调试签名，或在本地放同名材料。
    //   本地构建/上架签名见 docs/构建与签名.md，用自己的证书在本地配置，不要提交进来。
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        targetSdkVersion: '26.0.0',
        compatibleSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}


